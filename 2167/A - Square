#include <iostream>
#include <algorithm>
using namespace std;
 
int main() {
    int t;
    cin >> t;
    while (t--) {
        int a, b, c, d;
        cin >> a >> b >> c >> d;
        // On trie pour simplifier la vérification
        int sticks[4] = {a, b, c, d};
        sort(sticks, sticks + 4);
        if (sticks[0]==sticks[1] && sticks[1]==sticks[2] && sticks[2]==sticks[3]) {
            cout << "YES
";
        } else {
            cout << "NO
";
        }
    }
    return 0;
}